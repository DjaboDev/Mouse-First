#!/usr/bin/env bash
# mf-dock-check: detecta genericamente a presença de qualquer dock no sistema
# Retorna 1 se uma dock estiver ativa/presente, 0 caso contrário.

python3 -c "
import sys, json, os, subprocess

# 1. Checa margem inferior reservada nos monitores (Hyprland reserved[3] > 0)
try:
    mons = json.loads(subprocess.check_output(['hyprctl', 'monitors', '-j'], stderr=subprocess.DEVNULL))
    if any(m.get('reserved', [0, 0, 0, 0])[3] > 0 for m in mons):
        print(1)
        sys.exit(0)
except Exception:
    pass

# 2. Checa camadas Wayland (Layer Shell) com namespace de dock
try:
    layers = json.loads(subprocess.check_output(['hyprctl', 'layers', '-j'], stderr=subprocess.DEVNULL))
    for scr, data in layers.items():
        for lvl, surfs in data.get('levels', {}).items():
            for s in surfs:
                ns = s.get('namespace', '').lower()
                if 'dock' in ns or 'wbar' in ns or 'plank' in ns:
                    print(1)
                    sys.exit(0)
except Exception:
    pass

# 3. Checa processos de dock conhecidos em execução
try:
    ret = subprocess.run(
        ['pgrep', '-f', '(omadock|nwg-dock|plank|latte-dock|wbar|dockx|tint2)'],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )
    if ret.returncode == 0:
        print(1)
        sys.exit(0)
except Exception:
    pass

print(0)
" 2>/dev/null || echo "0"
